# Copy to .env.local for local development. Never commit real values.

# PostgreSQL connection string. On Netlify, Netlify DB sets NETLIFY_DATABASE_URL
# automatically and this can be left unset. When neither is set in local
# development, Civitas uses an embedded PGlite database stored in ./.data.
DATABASE_URL=

# Secret used by Auth.js to sign staff sessions. Generate with: npx auth secret
AUTH_SECRET=

# Gemini API key (server-side only). Without it, reports are still accepted and
# classified by deterministic rules; AI analysis is shown as "not configured".
GEMINI_API_KEY=
# Optional model override.
GEMINI_MODEL=gemini-2.5-flash

# Set to "evaluation" to show a banner stating that this deployment is a
# hackathon evaluation instance that is not connected to any municipality.
NEXT_PUBLIC_DEPLOYMENT_MODE=evaluation

# Optional map configuration (public values).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_CENTER_LAT=-26.2041
NEXT_PUBLIC_MAP_CENTER_LNG=28.0473
NEXT_PUBLIC_MAP_ZOOM=11

# Only for running `next start` locally without PostgreSQL (used by the
# end-to-end tests). Never set this on a serverless host: the embedded
# database lives on the local filesystem.
CIVITAS_ALLOW_EMBEDDED_DB=
